<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
        Title="MainWindow" Height="460" Width="624">
    <Grid HorizontalAlignment="Center" Width="624" Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="53*"/>
            <RowDefinition Height="23*"/>
            <RowDefinition Height="28*"/>
            <RowDefinition Height="28*"/>
            <RowDefinition Height="28*"/>
            <RowDefinition Height="28*"/>
            <RowDefinition Height="28*"/>
            <RowDefinition Height="28*"/>
            <RowDefinition Height="141*"/>
            <RowDefinition Height="50*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="66*"/>
            <ColumnDefinition Width="246*"/>
            <ColumnDefinition Width="39*"/>
            <ColumnDefinition Width="136*"/>
            <ColumnDefinition Width="86*"/>
            <ColumnDefinition Width="51*"/>
        </Grid.ColumnDefinitions>
        <Border BorderBrush="Black" BorderThickness="0.5" HorizontalAlignment="Left" Height="312" Grid.Row="1" VerticalAlignment="Center" Width="241" Margin="50,0,0,0" Grid.RowSpan="8" Grid.ColumnSpan="2">

        </Border>
        <Border BorderBrush="Black" BorderThickness="0.5" Grid.Column="2" HorizontalAlignment="Left" Height="312" Grid.Row="1" VerticalAlignment="Center" Width="240" Margin="20,0,0,0" Grid.RowSpan="8" Grid.ColumnSpan="3"/>
        <Label Content="Edit contact" HorizontalAlignment="Left" Height="28" Margin="60,43,0,0" VerticalAlignment="Top" Width="74" Grid.RowSpan="2" Background="White" Grid.ColumnSpan="2"/>
        <Label Grid.Column="2" Content="Read contact" HorizontalAlignment="Left" Height="28" Margin="33,43,0,0" VerticalAlignment="Top" Width="81" Grid.RowSpan="2" Background="White" Grid.ColumnSpan="2"/>
        <Label Content="Name:" HorizontalAlignment="Left" Height="25" Margin="60,0,0,0" VerticalAlignment="Center" Width="47" Grid.Row="2" Grid.ColumnSpan="2"/>
        <Label Grid.Column="2" Content="Name:" HorizontalAlignment="Left" Height="25" Margin="33,0,0,0" VerticalAlignment="Center" Width="44" Grid.ColumnSpan="2" Grid.Row="2"/>
        <Label Content="Phone number:" HorizontalAlignment="Left" Height="25" Margin="60,0,0,0" VerticalAlignment="Center" Width="91" Grid.ColumnSpan="2" Grid.Row="4"/>
        <Label Grid.Column="2" Content="Phone number:" HorizontalAlignment="Left" Height="25" Margin="33,0,0,0" VerticalAlignment="Center" Width="91" Grid.ColumnSpan="2" Grid.Row="4"/>
        <Label Content="Email:" HorizontalAlignment="Left" Height="25" Margin="60,0,0,0" VerticalAlignment="Center" Width="116" Grid.ColumnSpan="2" Grid.Row="6"/>
        <Label Grid.Column="2" Content="Email:" HorizontalAlignment="Left" Height="25" Margin="34,0,0,0" VerticalAlignment="Center" Width="86" Grid.ColumnSpan="2" Grid.Row="6"/>

        <!-- Вывод данных -->
        <Label 
            Grid.Column="2" 
            Content="{Binding Name}" 
            HorizontalAlignment="Left" 
            Height="25" 
            Margin="33,0,0,0" 
            VerticalAlignment="Center" 
            Width="215" 
            FontWeight="Bold" 
            Grid.ColumnSpan="3" 
            Grid.Row="3"
            />
        <Label 
            Grid.Column="2" 
            Content="{Binding PhoneNumber}" 
            HorizontalAlignment="Left" 
            Height="25" 
            VerticalAlignment="Center" 
            Width="214" 
            FontWeight="Bold" 
            Grid.Row="5" 
            Grid.ColumnSpan="3" 
            Margin="34,0,0,0"
            />
        <Label 
            Grid.Column="2" 
            Content="{Binding Email}" 
            HorizontalAlignment="Left" 
            Height="25" 
            Margin="34,0,0,0" 
            VerticalAlignment="Center" 
            Width="214" 
            FontWeight="Bold" 
            Grid.ColumnSpan="3" 
            Grid.Row="7"
            />

        <!-- Текстовые поля -->
        <TextBox 
            HorizontalAlignment="Left" 
            Height="24" 
            Margin="63,0,0,0" 
            TextWrapping="Wrap" 
            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
            VerticalAlignment="Center"
            Width="216" 
            Grid.ColumnSpan="2" 
            Grid.Row="3"
            />
        <TextBox 
            HorizontalAlignment="Left" 
            Height="25" 
            TextWrapping="Wrap" 
            Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" 
            VerticalAlignment="Center" 
            Width="216" 
            Grid.Row="5" 
            Grid.ColumnSpan="2" 
            Margin="63,0,0,0"
            />
        <TextBox 
            HorizontalAlignment="Left" 
            Height="25" 
            Margin="63,0,0,0" 
            TextWrapping="Wrap" 
            Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
            VerticalAlignment="Center" 
            Width="216" 
            Grid.ColumnSpan="2" 
            Grid.Row="7"
            />
        
        <!-- Кнопки -->
        <Button 
            Grid.Column="4" 
            Content="Load" 
            Command="{Binding LoadCommand}"
            HorizontalAlignment="Center" 
            Height="25" 
            Grid.Row="9" 
            VerticalAlignment="Top" 
            Width="76" 
            Margin="0,5,0,0"
            />
        <Button 
            Grid.Column="3" 
            Content="Save" 
            Command="{Binding SaveCommand}"
            HorizontalAlignment="Left" 
            Height="25" 
            Grid.Row="9" 
            VerticalAlignment="Top" 
            Width="76" 
            Margin="55,5,0,0"
            />
    </Grid>
</Window>
