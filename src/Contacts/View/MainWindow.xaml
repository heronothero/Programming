<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        xmlns:Controls="clr-namespace:View.Controls" x:Class="View.MainWindow"
        mc:Ignorable="d"
        xmlns:model="clr-namespace:Contacts.Model;assembly=Contacts.Model"
        Title="MainWindow" Height="460" Width="624" Grid.IsSharedSizeScope="True" ResizeMode="NoResize">
    <Window.Resources>
        <DataTemplate DataType="{x:Type model:Contact}">
            <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                <TextBlock Text="{Binding Phone}"/>
                <TextBlock Text="{Binding Email}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid HorizontalAlignment="Center" Width="624" Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="257*"/>
            <RowDefinition Height="30*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="86*"/>
            <ColumnDefinition Width="85*"/>
            <ColumnDefinition Width="82*"/>
            <ColumnDefinition Width="12*"/>
            <ColumnDefinition Width="124*"/>
            <ColumnDefinition Width="235*"/>
        </Grid.ColumnDefinitions>
        <GridSplitter Grid.RowSpan="7" HorizontalAlignment="Left" Grid.ColumnSpan="4" Width="265" Height="443" VerticalAlignment="Bottom" Grid.IsSharedSizeScope="True"/>
        <Label Width="35" VerticalAlignment="Top" Margin="10,0,0,0" Height="25" HorizontalAlignment="Left" Content="Find:"/>

        <!-- Кнопки -->
        <GridSplitter Height="443" VerticalAlignment="Top" Margin="0,-9,12,0" Grid.RowSpan="7" Grid.ColumnSpan="3" Width="237" Grid.IsSharedSizeScope="True"/>
        <ListBox 
            ItemsSource="{Binding Contacts}"
            SelectedItem="{Binding SelectedContact}"
            Margin="10,3,7,7" 
            Grid.RowSpan="5" 
            Grid.ColumnSpan="3"
            Grid.Row="1" Grid.IsSharedSizeScope="True"
            />
        <TextBox 
            TextWrapping="Wrap" 
            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
            Grid.ColumnSpan="3" 
            Margin="47,2,7,3" Grid.IsSharedSizeScope="True"
            />
        <Label Content="Find:" Height="25" VerticalAlignment="Top" Margin="10,0,41,0" Grid.IsSharedSizeScope="True"/>
        <Button 
            Content="Edit" 
            Command="{Binding EditCommand}"
            Height="25" 
            Grid.Row="6" 
            VerticalAlignment="Center" 
            Margin="2,0,3,0" Grid.Column="1" Grid.IsSharedSizeScope="True"
            />
        <Button 
            VerticalAlignment="Center" 
            Grid.Row="6" 
            Height="25" 
            Content="Add" 
            Command="{Binding AddCommand}"
            Margin="10,0,2,0" Grid.IsSharedSizeScope="True"
            />
        <Button 
            Grid.Column="2" 
            Content="Remove" 
            Command="{Binding RemoveCommand}"
            Height="25" 
            Grid.Row="6" 
            VerticalAlignment="Center" Margin="2,0,7,0" Grid.IsSharedSizeScope="True"
            />
        <Controls:ContactControl DataContext="{Binding SelectedContact}" Grid.Column="4" Grid.ColumnSpan="2" Height="415" Margin="5,0,0,0" Grid.RowSpan="7" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="344" Grid.IsSharedSizeScope="True"/>
        <Button Grid.Column="4" Content="Apply" Command="{Binding ApplyCommand}" HorizontalAlignment="Left" Height="25" Margin="35,31,0,0" Grid.Row="5" VerticalAlignment="Top" Width="75" Grid.IsSharedSizeScope="True"/>
    </Grid>
</Window>
