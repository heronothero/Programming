<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        xmlns:Controls="clr-namespace:View.Controls" x:Class="View.MainWindow"
        mc:Ignorable="d"
        xmlns:model="clr-namespace:View.Model"
        Title="MainWindow" Height="460" Width="624">
    <Window.Resources>
        <DataTemplate DataType="{x:Type model:Contact}">
            <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                <TextBlock Text="{Binding Phone}"/>
                <TextBlock Text="{Binding Email}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid HorizontalAlignment="Center" Width="624" Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="257*"/>
            <RowDefinition Height="30*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="86*"/>
            <ColumnDefinition Width="85*"/>
            <ColumnDefinition Width="94*"/>
            <ColumnDefinition Width="124*"/>
            <ColumnDefinition Width="235*"/>
        </Grid.ColumnDefinitions>
        <GridSplitter Grid.RowSpan="7" Margin="0,-9,0,0" HorizontalAlignment="Stretch" Grid.ColumnSpan="3"/>
        <Label Width="35" VerticalAlignment="Top" Margin="10,0,0,0" Height="25" HorizontalAlignment="Left" Content="Find:"/>

        <!-- Кнопки -->
        <GridSplitter HorizontalAlignment="Stretch" Height="443" VerticalAlignment="Top" Margin="4,-9,24,0" Grid.RowSpan="7" Grid.ColumnSpan="3"/>
        <ListBox 
            ItemsSource="{Binding Contacts}"
            SelectedItem="{Binding SelectedContact}"
            Margin="10,3,19,7" 
            Grid.RowSpan="5" 
            Grid.ColumnSpan="3"
            Grid.Row="1"
            />
        <TextBox 
            Height="25" 
            TextWrapping="Wrap" 
            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
            VerticalAlignment="Center" 
            Grid.ColumnSpan="3" 
            Margin="47,0,19,0"
            />
        <Label Content="Find:" HorizontalAlignment="Left" Height="25" VerticalAlignment="Top" Width="35" Margin="10,0,0,0"/>
        <Button 
            Content="Edit" 
            Command="{Binding EditCommand}"
            Height="25" 
            Grid.Row="6" 
            VerticalAlignment="Center" 
            Margin="2,0,3,0" Grid.Column="1"
            />
        <Button 
            VerticalAlignment="Center" 
            Grid.Row="6" 
            Height="25" 
            Content="Add" 
            Command="{Binding AddCommand}"
            Margin="10,0,2,0"
            />
        <Button 
            Grid.Column="2" 
            Content="Remove" 
            Command="{Binding RemoveCommand}"
            Height="25" 
            Grid.Row="6" 
            VerticalAlignment="Center" Margin="2,0,19,0"
            />
        <Controls:ContactControl DataContext="{Binding SelectedContact}" Grid.Column="3" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="438" Margin="5,0,0,-23" Grid.RowSpan="7" VerticalAlignment="Bottom" Width="344"/>
        <Button Grid.Column="3" Content="Apply" Command="{Binding ApplyCommand}" HorizontalAlignment="Left" Height="25" Margin="35,31,0,0" Grid.Row="5" VerticalAlignment="Top" Width="75"/>
    </Grid>
</Window>
