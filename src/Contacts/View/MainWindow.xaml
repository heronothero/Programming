<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
        Title="MainWindow" Height="460" Width="624">
    <Grid HorizontalAlignment="Center" Width="624" Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="257*"/>
            <RowDefinition Height="30*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="86*"/>
            <ColumnDefinition Width="80*"/>
            <ColumnDefinition Width="96*"/>
            <ColumnDefinition Width="11*"/>
            <ColumnDefinition Width="101*"/>
            <ColumnDefinition Width="84*"/>
            <ColumnDefinition Width="165*"/>
        </Grid.ColumnDefinitions>
        <GridSplitter Grid.RowSpan="7" Margin="0,-9,0,0" HorizontalAlignment="Stretch" Grid.ColumnSpan="3"/>
        <Label Width="35" VerticalAlignment="Top" Margin="10,0,0,0" Height="25" HorizontalAlignment="Left" Content="Find:"/>
        <Image Grid.Column="4" Grid.RowSpan="5" Margin="1,29,1,20"/>
        <Label Grid.Column="5" Content="Name:" HorizontalAlignment="Left" Height="25" VerticalAlignment="Top" Width="45"/>
        <Label Grid.Column="5" Content="Phone number:" HorizontalAlignment="Left" Height="25" Grid.Row="2" VerticalAlignment="Center" Width="105" Grid.ColumnSpan="2"/>
        <Label Grid.Column="5" Content="Email:" HorizontalAlignment="Center" Height="25" Margin="0,1,0,0" Grid.Row="4" VerticalAlignment="Top" Width="75"/>

        <!-- Текстовые поля -->
        <TextBox 
            Grid.Column="5" 
            Height="25" 
            TextWrapping="Wrap" 
            Text="{Binding SelectedContact.Name, UpdateSourceTrigger=PropertyChanged}" 
            VerticalAlignment="Top" 
            Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,36,0"
            />
        <TextBox 
            Grid.Column="5" 
            Height="25" 
            Grid.Row="3" 
            TextWrapping="Wrap" 
            Text="{Binding SelectedContact.Phone, UpdateSourceTrigger=PropertyChanged}"
            VerticalAlignment="Top" 
            Margin="0,1,36,0" Grid.ColumnSpan="2"
            />
        <TextBox 
            Grid.Column="5" 
            Height="25" 
            Margin="0,1,36,0" 
            Grid.Row="5"
            TextWrapping="Wrap" 
            Text="{Binding SelectedContact.Email, UpdateSourceTrigger=PropertyChanged}" 
            VerticalAlignment="Top" Grid.ColumnSpan="2"
            />

        <!-- Кнопки -->
        <GridSplitter HorizontalAlignment="Stretch" Height="443" VerticalAlignment="Top" Margin="4,-9,24,0" Grid.RowSpan="7" Grid.ColumnSpan="3"/>
        <Button 
            Grid.Column="5" 
            Content="Apply" 
            Command="{Binding ApplyCommand}"
            HorizontalAlignment="Center" 
            Height="25" 
            Margin="0,63,0,0" 
            Grid.Row="5" 
            VerticalAlignment="Top" 
            Width="75"
            />
        <ListBox 
            ItemsSource="{Binding Contacts}"
            SelectedItem="{Binding SelectedContact}"
            DisplayMemberPath="Name"
            Margin="10,3,19,7" 
            Grid.RowSpan="5" 
            Grid.ColumnSpan="3"
            Grid.Row="1"
            />
        <TextBox 
            Height="25" 
            TextWrapping="Wrap" 
            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
            VerticalAlignment="Center" 
            Grid.ColumnSpan="3" 
            Margin="47,0,19,0"
            />
        <Label Content="Find:" HorizontalAlignment="Left" Height="25" VerticalAlignment="Top" Width="35" Margin="10,0,0,0"/>
        <Button 
            Content="Edit" 
            Command="{Binding EditCommand}"
            Height="25" 
            Grid.Row="6" 
            VerticalAlignment="Center" 
            Margin="2,0,3,0" Grid.Column="1"
            />
        <Button 
            VerticalAlignment="Center" 
            Grid.Row="6" 
            Height="25" 
            Content="Add" 
            Command="{Binding AddCommand}"
            Margin="10,0,2,0"
            />
        <Button 
            Grid.Column="2" 
            Content="Remove" 
            Command="{Binding RemoveCommand}"
            Height="25" 
            Grid.Row="6" 
            VerticalAlignment="Center" Margin="2,0,19,0"
            />
    </Grid>
</Window>
