<UserControl x:Class="View.Controls.ContactControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:View.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" Width="340" Height="340">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="107*"/>
            <ColumnDefinition Width="233*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="29*"/>
            <RowDefinition Height="25*"/>
            <RowDefinition Height="26*"/>
            <RowDefinition Height="29*"/>
            <RowDefinition Height="26*"/>
            <RowDefinition Height="315*"/>
        </Grid.RowDefinitions>
        <Label Grid.Column="1" Content="Name:" HorizontalAlignment="Left" Height="25" VerticalAlignment="Center" Width="161"/>
        <Image Margin="2,4,5,294" Grid.RowSpan="5" Grid.Row="1" Width="100" Source="/Controls/free-icon-human-4466332.png"/>
        <TextBox 
            Grid.Column="1" 
            Grid.Row="1" 
            TextWrapping="Wrap" 
            Text="{Binding Name, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
            ToolTip="{Binding (Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}" 
            HorizontalAlignment="Center" 
            Width="232"
            />
        <Label Grid.Column="1" Content="Phone number:" Grid.Row="2" Margin="0,0,116,1"/>
        <TextBox 
            PreviewTextInput="Phone_PreviewTextInput"
            DataObject.Pasting="Phone_Pasting"
            Grid.Column="1" 
            Grid.Row="3" 
            TextWrapping="Wrap" 
            Text="{Binding Phone, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
            ToolTip="{Binding (Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}"
            Margin="1,0,0,4"
            />
        <Label Grid.Column="1" Content="Email:" Grid.Row="4" HorizontalAlignment="Left" Width="70" Height="24" VerticalAlignment="Center"/>
        <TextBox 
            Height="25" 
            Grid.Row="5" 
            TextWrapping="Wrap" 
            Text="{Binding Email, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
            ToolTip="{Binding (Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}"
            VerticalAlignment="Top" 
            Grid.Column="1"
            />

    </Grid>
</UserControl>
